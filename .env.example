# Please copy this file to .env and fill in your own values. Every setting that Talk reads is listed here, and each group has a sentence above it that says what it is for.
# A setting that is left out of your .env keeps the default built into the code, and a line that is commented out here is left to that default on purpose.
# Keys and secrets are never committed. Please type them into your own .env file yourself.

# Where Talk keeps its records and the files it writes. The default is a SQLite file, which is enough for a single server. PostgreSQL works too, after
# "pip install .[postgres]", with DATABASE_URL=postgresql+psycopg://user:password@host:5432/name. REDIS_URL is optional, and when it is empty the working memory of
# calls is kept inside the process. PUBLIC_BASE_URL is the address that people reach Talk on, and when it starts with https, a callback secret that is still at the
# default published with the code is replaced by a random one every time Talk starts.
DATABASE_URL=sqlite:///./data/sofa.db
STORAGE_DIR=./data
REDIS_URL=
PUBLIC_BASE_URL=http://localhost:8000

# The telephony and text message provider. AT_CALLBACK_SECRET becomes part of the callback address (https://<your address>/voice/inbound/<the secret>), so it must be a
# long random text, for example from: python -c "import secrets; print(secrets.token_urlsafe(24))". It also seeds each provider system's own signing secret. When it is
# not set, a published default is used on a private address and replaced by a random secret on an https address, which keeps the callback shut until you set your own.
# With no AT_API_KEY the text messages are only written to the log and none is sent. TALK_NUMBER is the number that callers dial; when it is empty, Talk answers
# every number that it is called on.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SANDBOX=true
# AT_CALLBACK_SECRET=
SMS_SENDER_ID=
TALK_NUMBER=

# The Meta models. Muse Spark understands each sentence as strict JSON, and Muse Voice Transcribe turns the caller's speech into text. Please use a Standard model for
# LLM_MODEL and never a model whose name ends in -contributor, because those may be used to train Meta's models. LLM_REASONING_EFFORT is minimal, low, medium or high,
# and a lower setting answers faster. ASR_API_KEY is only needed when the speech model uses a different key from LLM_API_KEY. To run entirely on the stand-in models
# that the tests use, with no key and no network, set both LLM_URL and ASR_URL to inprocess://mock. ASR_KEYWORDS adds words for the speech model to listen for, separated
# by commas, to the place, clinic and medicine names that Talk already gives it.
LLM_PROVIDER=meta
LLM_URL=https://api.meta.ai
LLM_MODEL=muse-spark-1.3
LLM_REASONING_EFFORT=minimal
LLM_API_KEY=
ASR_URL=https://api.meta.ai
ASR_MODEL=muse-voice-transcribe-1.0
ASR_API_KEY=
ASR_KEYWORDS=

# The voice that callers hear. TTS_PROVIDER is spitch (the hosted Nigerian-accent English voice, which needs SPITCH_API_KEY), piper (a voice on this machine) or standin
# (a silent stand-in for tests). With PIPER_MODEL set to a Piper voice file, that voice speaks whenever the hosted voice is out of reach, so that a caller never hears
# silence; deploy/setup_voice.sh installs one. TTS_HOSTED_SPEED and PIPER_SPEED are the speaking speeds, where 1.0 is normal.
TTS_PROVIDER=spitch
TTS_HOSTED_SPEED=0.95
SPITCH_API_KEY=
SPITCH_VOICE_EN=jude
# With TTS_PROVIDER=azure, Microsoft Azure Speech speaks instead, in a Nigerian English voice: the key and the region of a Speech resource (for example
# northeurope), and AZURE_VOICE, which is en-NG-EzinneNeural (female) or en-NG-AbeoNeural (male). The free tier allows 20 requests a minute.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE=en-NG-EzinneNeural
PIPER_MODEL=
PIPER_SPEED=1.0

# What Talk offers and how it behaves on a call. SERVICES_ENABLED lists the services a caller can reach, and a service that is left out is politely declined and has no
# tools registered. REPLY_WORDING lets the model word Talk's replies, with every fact still coming from the provider and the wording checked before it is spoken, and
# false means fixed wording only. A call ends after MAX_SILENCES silent turns in a row, which is the only time Talk hangs up, and no call runs longer than
# MAX_CALL_SECONDS. One number may place at most MAX_CALLS_PER_HOUR calls in an hour.
SERVICES_ENABLED=health
REPLY_WORDING=true
MAX_SILENCES=2
MAX_CALL_SECONDS=480
MAX_CALLS_PER_HOUR=20

# The simulated provider systems: a state health network, a private clinic group, a pharmacy chain and a cancer centre. Each runs beside Talk at /synthetic/<name> and is
# reached through its own signed request. HOSPITAL_BASE_URL is the address that Talk uses to reach them, and when it is empty the address is PUBLIC_BASE_URL with
# /synthetic added, using https. On a machine without an https address, set it to http://127.0.0.1:8000/synthetic, which is the application's own address.
# HOSPITAL_SIGNING_SECRET is the text from which each provider's own secret is derived, and when it is empty AT_CALLBACK_SECRET is used. HOSPITAL_DB_DIR is where each
# provider keeps its database file, and when it is empty STORAGE_DIR is used. HOSPITAL_STAFF_PHONE is a number that is texted when an urgent request, such as an emergency,
# reaches a provider's front desk, and with no number nothing is texted. HOSPITAL_DESK_KEY lets a front-desk page confirm visits, mark them attended or missed, and reply
# to requests when the page is opened with ?key=<the key>, and with no key the pages are read only.
SYNTHETIC_HOSPITAL=true
HOSPITAL_BASE_URL=
HOSPITAL_SIGNING_SECRET=
HOSPITAL_DB_DIR=
HOSPITAL_STAFF_PHONE=
HOSPITAL_DESK_KEY=

# The public pages. DEMO_PAGE_ENABLED turns on the Live calls page at /demo, which shows counts and the steps Talk took on recent calls, with phone numbers masked; it is off
# by default because it is public. DEMO_SHOW_CALLS also shows what callers said and what Talk replied, and it must only be true for a demonstration in which every caller
# knows that this is shown. OVERVIEW_ENABLED turns the home, how-it-works and providers pages on or off. CONTACT_EMAIL, TEST_NUMBER and COST_NOTE are shown
# on those pages when they are set, namely an address to write to, the number to call and a note about what testing costs.
DEMO_PAGE_ENABLED=false
DEMO_SHOW_CALLS=false
OVERVIEW_ENABLED=true
CONTACT_EMAIL=
TEST_NUMBER=
# A second number for visitors outside Nigeria (for example a United States number that reaches the same Talk). It is shown beside TEST_NUMBER on the Try it page.
TEST_NUMBER_INTERNATIONAL=

# The second telephony provider, Twilio, for visitors outside Nigeria. Point the number's voice webhook at /voice/twilio/inbound/<AT_CALLBACK_SECRET> and its status callback at /voice/twilio/status/<AT_CALLBACK_SECRET>,
# both with POST. With the token set, every callback must carry Twilio's own signature. The account key is also needed to download the recordings, which Twilio protects.
# The networks the telephony providers call from, as CIDR blocks separated by commas. When set, a callback from any other address is refused, as a second
# lock beside the secret in the callback address. Ask each provider for its list, and make one test call after setting it.
CALLBACK_ALLOWED_NETWORKS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
COST_NOTE=

# The Try it page at /try, where a visitor calls or types to Talk in the browser. Every turn costs a model call, so a conversation ends after TRY_MAX_TURNS turns, one visitor
# address may send TRY_TURNS_PER_HOUR turns in an hour, and a conversation is forgotten after TRY_SESSION_MINUTES minutes. Switched off, the page answers 404.
TRY_PAGE_ENABLED=true
# Sofa remembers a person from one call to the next: the area they are in and the clinic where it last booked them, never why they needed care. A caller is
# recognised by their number, a browser by a random identifier in a cookie; neither is stored, only a one-way key. Forgotten after this many days without a call; 0 = off.
CALLER_MEMORY_DAYS=90
# The model reads the whole call and decides each step, with the guard rails in code; when it gives no usable decision the rules answer the turn. false = the rules always decide.
DIALOGUE_AGENT=true
# Paying for a visit or a medicine by bank transfer. With a Paystack secret key, each payment gets its own temporary account from Paystack's Pay with Transfer
# (ask Paystack support to switch it on) and Paystack's webhook at /payments/paystack confirms it. Without one, the account is simulated and confirmed from the
# Try it page. PAYMENT_HOURS is how long an account stays valid (1 to 8).
PAYSTACK_SECRET_KEY=
# WhatsApp: people chat with Sofa on WhatsApp and send photos of a medicine pack or a prescription. From a Meta app with the WhatsApp product: the phone number id,
# a system user's access token, the verify token you choose for the webhook at https://<your host>/whatsapp/webhook, the app secret, and the business account id.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
PAYMENT_HOURS=8
TRY_MAX_TURNS=20
TRY_TURNS_PER_HOUR=60
TRY_SESSION_MINUTES=30

# The hospital onboarding wizard at /onboard, where a visitor makes a simulated hospital of their own, connects it to Talk and receives its first appointment. Every hospital is
# seen only by the visitor who made it, holds made-up data only and is removed after DEMO_ONBOARDING_HOURS. At most DEMO_ONBOARDING_MAX_ACTIVE hospitals exist at once, and
# one visitor address may start DEMO_ONBOARDING_PER_ADDRESS_PER_HOUR in an hour. Switched off, the pages answer 404.
DEMO_ONBOARDING_ENABLED=true
DEMO_ONBOARDING_HOURS=24
DEMO_ONBOARDING_MAX_ACTIVE=40
DEMO_ONBOARDING_PER_ADDRESS_PER_HOUR=6

# Privacy and safety. A caller's recording is deleted RECORDING_RETENTION_DAYS days after the call, while what was said stays in the call record as text, and 0 keeps
# recordings. A recording is downloaded only over https and only from the telephony provider's own hosts. RECORDING_ALLOWED_HOSTS replaces that built-in list with
# the host names you give, separated by commas, and sub-domains are included. It is commented out so that the built-in list applies, and an empty value would allow any
# host, which is not safe. Calls from the numbers in TEST_CALLER_NUMBERS are marked as test calls in the call records. DEBUG_HEADERS adds each reply's text to the
# X-Sofa-* headers of the callback answers, which only scripts/simulate_call.py needs, so please leave it false on a public server.
RECORDING_RETENTION_DAYS=30
# RECORDING_ALLOWED_HOSTS=
TEST_CALLER_NUMBERS=+2348000000001
DEBUG_HEADERS=false

# Background jobs, which run inside the application: deleting recordings that are past their time, removing hospitals made in the wizard when their time is up, and
# sending the reminders and follow-up texts around a booked visit. SCHEDULER_INTERVAL_SECONDS is the pause between two passes.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# The timing of a call over the callback path. ASR_MIN_CONFIDENCE is the lowest speech confidence that is accepted before Talk asks the caller to repeat. A holding message
# is played when a reply takes longer than FILLER_AFTER_SECONDS, and again every FILLER_EVERY_SECONDS after that. A reply that is not spoken within TTS_BUDGET_SECONDS is
# replaced by its stored wording. The recording of a caller's turn ends after RECORD_TIMEOUT_SECONDS of silence or RECORD_MAX_SECONDS in all, and a recording quieter than
# SILENCE_RMS (on a scale of 0 to 32767) is treated as silence.
ASR_MIN_CONFIDENCE=-1.3
FILLER_AFTER_SECONDS=2.0
FILLER_EVERY_SECONDS=6.0
TTS_BUDGET_SECONDS=4.0
RECORD_TIMEOUT_SECONDS=2
RECORD_MAX_SECONDS=15
SILENCE_RMS=150.0

# Streamed calls over a SIP trunk (deploy/setup_sip.sh sets up Asterisk and switches this on). The agent listens on SIP_HOST and SIP_PORT, and Asterisk is the only thing
# that connects to it. Up to SIP_MAX_CALLS calls run at once. A slice of the line louder than SIP_VOICE_RMS is speech, and speech has ended after SIP_END_SILENCE_MS of
# quiet. Less than SIP_MIN_SPEECH_MS of speech is a click or a cough, and a turn longer than SIP_MAX_SPEECH_SECONDS is cut and read. When nobody speaks for
# SIP_SILENCE_SECONDS after Talk has finished, Talk gives the silence reply, and a reply slower than SIP_FILLER_AFTER_SECONDS gets a short holding message. With SIP_BARGE_IN
# true, a caller who speaks over Talk for SIP_BARGE_MS milliseconds stops Talk.
SIP_ENABLED=false
SIP_HOST=127.0.0.1
SIP_PORT=4574
SIP_MAX_CALLS=8
SIP_VOICE_RMS=300.0
SIP_END_SILENCE_MS=800
SIP_MIN_SPEECH_MS=240
SIP_MAX_SPEECH_SECONDS=15
SIP_SILENCE_SECONDS=8.0
SIP_FILLER_AFTER_SECONDS=3.5
SIP_BARGE_IN=true
SIP_BARGE_MS=400
