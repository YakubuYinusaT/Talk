# Text files keep Unix line endings, so that the shell scripts run on the server whichever system committed them.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.service text eol=lf
*.conf text eol=lf

# These files are binary and are never converted.
*.png binary
*.woff2 binary
